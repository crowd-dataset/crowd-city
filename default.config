{
  "data": ["/Volumes/Alam/pedestrians_in-youtube/data"],
  "videos": ["videos"],
  "mapping": "mapping.csv",
  "machine_name": "dashcaminator",
  "tracking_mode": true,
  "always_analyse": true,
  "waymo_dataset_path": "/Volumes/Alam/waymo_dataset",
  "process_waymo_if_missing": true,
  "delete_youtube_video": false,
  "save_annotated_video": false,
  "delete_runs_files": true,
  "min_max_videos": 0,
  "track_buffer_sec": 2,
  "bbox_tracker": "bbox_custom_tracker.yaml",
  "tracking_model": "yolo11x.pt",
  "cpu_worker": 4,
  "reanalyse_waiting_time": false,
  "min_waiting_time": 0,
  "max_waiting_time": 1e20,
  "min_locality_population_percentage": 0,
  "check_per_sec_time": 3,
  "analysis_level": "city",
  "sub_domain" : ["bbox"],
  "boundary_left": 0.45,
  "boundary_right": 0.55,
  "population_threshold": 0,
  "footage_threshold": 0,
  "min_city_population_percentage": 0.0,
  "min_crossing_detect": 0,
  "reanalyse_speed": false,
  "min_speed_limit": 0,
  "max_speed_limit": 1e20,
  "countries_analyse": ["MOZ"],
  "n_cities": null,
  "vehicles_analyse": [],
  "min_confidence": 0.7,
  "update_pop_country": false,
  "update_gini_value": false,
  "font_family": "verdana",
  "font_size": 18,
  "plotly_template": "plotly_white",
  "logger_level": "info",
  "git_pull": true,
  "email_send": false,
  "email_sender": "",
  "email_recipients": [],
  "ftp_base_url": "https://files.mobility-squad.com/",
  "display_frame_tracking": false,
  "save_annoted_img": false,
  "save_tracked_img": false,
  "delete_labels": true,
  "delete_frames": true
}
